# TLS in front of margind, reachable only over ZeroTier.
#
# DNS: create an A record mac.dev.example.com -> this machine's ZeroTier IP
# (e.g. 10.147.17.5). It's a private address, so nothing is exposed publicly.
# Certs come from Let's Encrypt via the DNS challenge, which needs a Caddy
# build with your DNS provider's module, e.g.:
#   xcaddy build --with github.com/caddy-dns/cloudflare
# and CLOUDFLARE_API_TOKEN set in Caddy's environment.

{
	# Only listen on the ZeroTier interface.
	default_bind 10.147.17.5
}

# One site block per workspace on this machine (each daemon has its own port).
mac.dev.example.com:8787 {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	reverse_proxy 127.0.0.1:8787
}

